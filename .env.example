# Optional LLM for narratives + the multi-agent bench team. Copy to .env (git-ignored) and fill ONE option.
# Without either, everything still runs on built-in templates and the rule-based agent team (English only).

# Option A — Azure OpenAI / Microsoft Foundry (hackathon-preferred; wins if both are set)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Option B — OpenAI API key (handy for local testing)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# MCP server (/api/mcp) — agents call every tool through MCP.
# PITCHPULSE_MCP_KEY: bearer token for HTTP MCP clients (generate: python -c "import secrets;print(secrets.token_urlsafe(32))").
#   Unset → HTTP MCP endpoint disabled (503); agents still use MCP in-process.
# PITCHPULSE_MCP_URL: set to make agents go over HTTP with the key (falls back to in-process if unreachable).
#   Single container / Render: auto (= http://127.0.0.1:$PORT/api/mcp) · local `python -m pitchpulse.api.main`: http://127.0.0.1:8011/mcp
PITCHPULSE_MCP_KEY=
PITCHPULSE_MCP_URL=

# API port (optional; default 8000). Example: PORT=8011
PORT=8011
