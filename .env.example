# Optional — Azure OpenAI / Microsoft Foundry (hackathon-preferred LLM path)
# Copy to .env and fill. Narratives work without this via built-in templates.
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# API port (optional; default 8000). Example: PORT=8011
PORT=8011
